DISCORD_TOKEN=여기에_봇_토큰
# 선택: 명령어로 만든 방에 아무도 안 들어오면 몇 초 뒤 삭제할지
EMPTY_GRACE_SECONDS=60
# 선택: 설정 저장 파일 위치
DATA_FILE=data.json
# 선택: 구인 글 자동 마감까지 시간 (0이면 자동 마감 안 함)
RECRUIT_EXPIRE_HOURS=3
# 선택: 자동 마감 시간 표시에 쓸 시간대
BOT_TIMEZONE=Asia/Seoul
# 선택: 들어올 때 자동 역할 (개발자 포털에서 Server Members Intent를 켠 뒤 1로)
MEMBERS_INTENT=0
# 선택: 구인·예약 카드 가로 크기(px). 작게 하고 싶으면 숫자를 줄이기 (예: 480)
CARD_WIDTH=600
